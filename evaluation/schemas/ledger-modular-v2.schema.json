{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger-modular-v2.schema.json",
  "title": "Ledger hierárquico de telemetria modular v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_modular_ledger",
    "evaluation_series",
    "detector_version",
    "catalog_schema",
    "catalog_version",
    "measurement_mode",
    "observed_is_not_eligibility",
    "capability_cost_mode",
    "parent_cost_method",
    "interactions",
    "events",
    "non_module_observations",
    "module_parent_costs",
    "cost_class_totals",
    "cost_closure",
    "corrections",
    "semantic_audits",
    "player_feedback"
  ],
  "properties": {
    "schema_modular_ledger": {"const": 2},
    "evaluation_series": {"const": "modules-v2"},
    "detector_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "catalog_schema": {"const": 2},
    "catalog_version": {"type": "string", "minLength": 1},
    "measurement_mode": {"const": "post_hoc_read_only"},
    "observed_is_not_eligibility": {"const": true},
    "capability_cost_mode": {"const": "exposicao_apenas"},
    "parent_cost_method": {"type": "string", "minLength": 1},
    "interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "non_module_observations": {"type": "array", "items": {"$ref": "#/$defs/nonModuleObservation"}},
    "module_parent_costs": {"type": "array", "items": {"$ref": "#/$defs/moduleCost"}},
    "cost_class_totals": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/classCost"}
    },
    "cost_closure": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/closure"}
    },
    "corrections": {"type": "array", "items": {"$ref": "#/$defs/appliedCorrection"}},
    "semantic_audits": {"type": "array", "items": {"$ref": "#/$defs/semanticAudit"}},
    "player_feedback": {"type": "array", "items": {"$ref": "#/$defs/playerFeedback"}}
  },
  "$defs": {
    "tokenCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "cached_input_tokens", "uncached_input_tokens_approx", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "uncached_input_tokens_approx": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_id", "interaction_ref", "session", "ordinal", "class", "state", "turn_id", "visible_reference_count", "visible_exactly_once", "receipt_present", "response_present"],
      "properties": {
        "interaction_id": {"type": ["string", "null"]},
        "interaction_ref": {"type": ["string", "null"], "pattern": "^S[0-9]{3,}-I[0-9]{4,}$"},
        "session": {"type": ["integer", "null"], "minimum": 1},
        "ordinal": {"type": "integer", "minimum": 1},
        "class": {"enum": ["ON", "OFF", "RECALL", "operacional"]},
        "state": {"enum": ["reserved", "complete", "incomplete"]},
        "turn_id": {"type": "string", "minLength": 1},
        "visible_reference_count": {"type": "integer", "minimum": 0},
        "visible_exactly_once": {"type": "boolean"},
        "receipt_present": {"type": "boolean"},
        "response_present": {"type": "boolean"},
        "input_sha256": {"type": ["string", "null"]},
        "response_sha256": {"type": ["string", "null"]},
        "transaction_id": {"type": ["string", "null"]},
        "ticket_id": {"type": ["string", "null"]},
        "release_set_id": {"type": ["string", "null"]},
        "catalog_version": {"type": ["string", "null"]},
        "module_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["implementation_version", "evaluation_version"],
            "properties": {
              "implementation_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
              "evaluation_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "session_id",
        "turn_id",
        "turn_ordinal",
        "interaction_id",
        "interaction_ref",
        "analysis_unit",
        "module_id",
        "capability_id",
        "signal_sources",
        "eligibility_observed",
        "activation_observed",
        "observed_result",
        "materialized_result_observed",
        "effect_observed",
        "observable_evidence",
        "inference_confidence",
        "adjudication",
        "cost",
        "detector_version",
        "module_implementation_version",
        "module_evaluation_version"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "session_id": {"type": ["string", "null"]},
        "turn_id": {"type": "string", "minLength": 1},
        "turn_ordinal": {"type": "integer", "minimum": 1},
        "interaction_id": {"type": ["string", "null"]},
        "interaction_ref": {"type": ["string", "null"], "pattern": "^S[0-9]{3,}-I[0-9]{4,}$"},
        "analysis_unit": {"enum": ["turno", "cena", "fronteira", "sessao", "evento"]},
        "module_id": {"type": "string", "minLength": 1},
        "capability_id": {"type": "string", "minLength": 1},
        "signal_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["comando", "output", "ticket", "resposta"]}
        },
        "eligibility_observed": {"enum": ["sim", "nao", "indeterminada"]},
        "activation_observed": {"enum": ["ausente", "gate_neutro", "consulta", "decisao", "efeito"]},
        "observed_result": {"type": ["string", "null"]},
        "materialized_result_observed": {"type": ["string", "null"]},
        "effect_observed": {"type": ["boolean", "null"]},
        "observable_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "inference_confidence": {"enum": ["alta", "media", "baixa"]},
        "adjudication": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/adjudication"}]},
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attribution_class", "exposed_non_additive", "parent_attributed_additive", "parent_allocation_role", "capability_cost_mode", "marginal_cost", "marginal_cost_status"],
          "properties": {
            "attribution_class": {"enum": ["controle", "dominio"]},
            "exposed_non_additive": {"$ref": "#/$defs/tokenCost"},
            "parent_attributed_additive": {"$ref": "#/$defs/tokenCost"},
            "parent_allocation_role": {"enum": ["primario", "exposicao_apenas"]},
            "capability_cost_mode": {"const": "exposicao_apenas"},
            "marginal_cost": {"type": "null"},
            "marginal_cost_status": {"const": "indeterminado"}
          }
        },
        "detector_version": {"type": "string", "minLength": 1},
        "module_implementation_version": {"type": "string", "minLength": 1},
        "module_evaluation_version": {"type": "string", "minLength": 1}
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_source", "eligibility", "activation", "materialized_result", "effect_observed", "reason", "evidence"],
      "properties": {
        "signal_source": {"const": "adjudicacao"},
        "eligibility": {"type": ["string", "null"], "enum": ["sim", "nao", "indeterminada", null]},
        "activation": {"type": ["string", "null"], "enum": ["ausente", "gate_neutro", "consulta", "decisao", "efeito", null]},
        "materialized_result": {"type": ["string", "null"]},
        "effect_observed": {"type": ["boolean", "null"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    },
    "nonModuleObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_id", "turn_id", "turn_ordinal", "interaction_id", "interaction_ref", "classification", "item_id", "signal_sources", "observable_evidence", "receives_modular_score", "receives_parent_cost"],
      "properties": {
        "session_id": {"type": ["string", "null"]},
        "turn_id": {"type": "string"},
        "turn_ordinal": {"type": "integer", "minimum": 1},
        "interaction_id": {"type": ["string", "null"]},
        "interaction_ref": {"type": ["string", "null"], "pattern": "^S[0-9]{3,}-I[0-9]{4,}$"},
        "classification": {"enum": ["regressao_historica", "extensao_campanha"]},
        "item_id": {"enum": ["seven_names_migration_regression", "underground_tournament"]},
        "signal_sources": {"type": "array", "items": {"enum": ["comando", "output"]}},
        "observable_evidence": {"type": "array", "items": {"type": "string"}},
        "receives_modular_score": {"const": false},
        "receives_parent_cost": {"const": false}
      }
    },
    "moduleCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "cost_class", "input_tokens", "cached_input_tokens", "uncached_input_tokens_approx", "output_tokens", "total_tokens"],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "cost_class": {"enum": ["controle", "dominio"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "uncached_input_tokens_approx": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "classCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cost_class", "input_tokens", "cached_input_tokens", "uncached_input_tokens_approx", "output_tokens", "total_tokens"],
      "properties": {
        "cost_class": {"enum": ["controle", "dominio"]},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "uncached_input_tokens_approx": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrative_total", "parent_attributed_total", "difference"],
      "properties": {
        "narrative_total": {"type": "integer", "minimum": 0},
        "parent_attributed_total": {"type": "integer", "minimum": 0},
        "difference": {"type": "integer"}
      }
    },
    "appliedCorrection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "observed_preserved", "adjudicated"],
      "properties": {
        "event_id": {"type": "string"},
        "observed_preserved": {"type": "object"},
        "adjudicated": {"$ref": "#/$defs/adjudication"}
      }
    },
    "semanticState": {"enum": ["adequado", "inadequado", "indeterminado", "nao_aplicavel"]},
    "guardrailState": {"enum": ["ok", "violado", "indeterminado", "nao_aplicavel"]},
    "semanticAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "evaluator", "dimensions", "guardrails", "evidence", "automatic_literary_score", "guardrails_compensable"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "evaluator": {"type": "string", "minLength": 1},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["progressao_jogavel", "densidade_proporcional", "voz_e_dialogo", "camadas_de_conhecimento", "conclusao_aberta"],
          "properties": {
            "progressao_jogavel": {"$ref": "#/$defs/semanticState"},
            "densidade_proporcional": {"$ref": "#/$defs/semanticState"},
            "voz_e_dialogo": {"$ref": "#/$defs/semanticState"},
            "camadas_de_conhecimento": {"$ref": "#/$defs/semanticState"},
            "conclusao_aberta": {"$ref": "#/$defs/semanticState"}
          }
        },
        "guardrails": {
          "type": "object",
          "additionalProperties": false,
          "required": ["player_agency", "knowledge_secrecy", "roll_integrity"],
          "properties": {
            "player_agency": {"$ref": "#/$defs/guardrailState"},
            "knowledge_secrecy": {"$ref": "#/$defs/guardrailState"},
            "roll_integrity": {"$ref": "#/$defs/guardrailState"}
          }
        },
        "evidence": {"type": "array", "items": {"type": "string"}},
        "automatic_literary_score": {"type": "null"},
        "guardrails_compensable": {"const": false}
      }
    },
    "playerFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedback_id", "interaction_ref", "recorded_at", "original_text", "perceived_type", "expectation", "observation", "perceived_impact", "player_module_id", "player_capability_id", "system_suggestion", "adjudication"],
      "properties": {
        "schema_interaction_event": {"const": 1},
        "event_type": {"const": "player_feedback"},
        "feedback_id": {"type": "string", "minLength": 1},
        "interaction_ref": {"type": "string", "pattern": "^S[0-9]{3,}-I[0-9]{4,}$"},
        "recorded_at": {"type": "string", "minLength": 1},
        "original_text": {"type": "string", "minLength": 1},
        "perceived_type": {"enum": ["boa_ativacao", "oportunidade_percebida", "sobreativacao_percebida", "ativacao_inadequada", "efeito_incorreto", "timing", "continuidade", "possivel_guardrail"]},
        "expectation": {"type": ["string", "null"]},
        "observation": {"type": ["string", "null"]},
        "perceived_impact": {"type": ["string", "null"], "enum": ["baixo", "moderado", "alto", "critico", null]},
        "player_module_id": {"type": ["string", "null"]},
        "player_capability_id": {"type": ["string", "null"]},
        "system_suggestion": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false, "required": ["module_id", "capability_id", "confidence", "evidence"], "properties": {
              "module_id": {"type": ["string", "null"]},
              "capability_id": {"type": ["string", "null"]},
              "confidence": {"type": ["string", "null"]},
              "evidence": {"type": "array", "items": {"type": "string"}}
            }}
          ]
        },
        "adjudication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {
            "state": {"enum": ["pendente", "confirmada", "parcial", "nao_confirmada", "indeterminada"]},
            "reason": {"type": ["string", "null"]}
          }
        }
      }
    }
  }
}
