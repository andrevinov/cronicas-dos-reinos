{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adjudicacoes-ledger-v2.schema.json",
  "title": "Adjudicações e percepção humana do ledger modular v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_adjudicacoes_modulares"],
  "properties": {
    "schema_adjudicacoes_modulares": {"const": 2},
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "reason"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "eligibility": {"type": ["string", "null"], "enum": ["sim", "nao", "indeterminada", null]},
          "activation": {"type": ["string", "null"], "enum": ["ausente", "gate_neutro", "consulta", "decisao", "efeito", null]},
          "materialized_result": {"type": ["string", "null"]},
          "effect_observed": {"type": ["boolean", "null"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "semantic_audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "evaluator", "dimensions", "guardrails", "evidence"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "evaluator": {"type": "string", "minLength": 1},
          "dimensions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["progressao_jogavel", "densidade_proporcional", "voz_e_dialogo", "camadas_de_conhecimento", "conclusao_aberta"],
            "properties": {
              "progressao_jogavel": {"$ref": "#/$defs/semanticState"},
              "densidade_proporcional": {"$ref": "#/$defs/semanticState"},
              "voz_e_dialogo": {"$ref": "#/$defs/semanticState"},
              "camadas_de_conhecimento": {"$ref": "#/$defs/semanticState"},
              "conclusao_aberta": {"$ref": "#/$defs/semanticState"}
            }
          },
          "guardrails": {"$ref": "#/$defs/guardrails"},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "quality_assessments": {
      "type": "array",
      "items": {
        "$ref": "avaliacoes-qualidade-interacao-v1.schema.json#/$defs/assessment"
      }
    },
    "player_feedback": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feedback_id", "interaction_ref", "recorded_at", "original_text", "perceived_type"],
        "properties": {
          "schema_interaction_event": {"const": 1},
          "event_type": {"const": "player_feedback"},
          "feedback_id": {"type": "string", "minLength": 1},
          "interaction_ref": {"type": "string", "pattern": "^S[0-9]{3,}-I[0-9]{4,}$"},
          "recorded_at": {"type": "string", "minLength": 1},
          "original_text": {"type": "string", "minLength": 1},
          "perceived_type": {"enum": ["boa_ativacao", "oportunidade_percebida", "sobreativacao_percebida", "ativacao_inadequada", "efeito_incorreto", "timing", "continuidade", "possivel_guardrail"]},
          "expectation": {"type": ["string", "null"]},
          "observation": {"type": ["string", "null"]},
          "perceived_impact": {"type": ["string", "null"], "enum": ["baixo", "moderado", "alto", "critico", null]},
          "player_module_id": {"type": ["string", "null"]},
          "player_capability_id": {"type": ["string", "null"]},
          "system_suggestion": {"type": ["object", "null"]},
          "adjudication": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "reason"],
            "properties": {
              "state": {"enum": ["pendente", "confirmada", "parcial", "nao_confirmada", "indeterminada"]},
              "reason": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "semanticState": {"enum": ["adequado", "inadequado", "indeterminado", "nao_aplicavel"]},
    "guardrailState": {"enum": ["ok", "violado", "indeterminado", "nao_aplicavel"]},
    "guardrails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_agency", "knowledge_secrecy", "roll_integrity"],
      "properties": {
        "player_agency": {"$ref": "#/$defs/guardrailState"},
        "knowledge_secrecy": {"$ref": "#/$defs/guardrailState"},
        "roll_integrity": {"$ref": "#/$defs/guardrailState"}
      }
    }
  }
}
