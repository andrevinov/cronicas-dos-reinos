{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agregacao-scorecard-v2.schema.json",
  "title": "Propagação fail-closed no scorecard modular v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "conclusao_permitida",
    "nota_parcial_componentes_validos",
    "modulos_catalogados",
    "modulos_incluidos",
    "modulos_bloqueados",
    "modulos_nao_avaliaveis",
    "denominadores",
    "regra"
  ],
  "properties": {
    "schema": {"const": 1},
    "status": {"enum": ["completa", "bloqueada_instrumentacao"]},
    "conclusao_permitida": {"type": "boolean"},
    "nota_parcial_componentes_validos": {"type": "boolean"},
    "modulos_catalogados": {"type": "integer", "minimum": 0},
    "modulos_incluidos": {"type": "integer", "minimum": 0},
    "modulos_bloqueados": {
      "type": "array",
      "items": {"$ref": "#/$defs/blockedModule"}
    },
    "modulos_nao_avaliaveis": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonEvaluableModule"}
    },
    "denominadores": {"$ref": "#/$defs/denominators"},
    "regra": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "blockedModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "motivo", "diagnostico"],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "motivo": {"const": "falha_instrumentacao"},
        "diagnostico": {"type": "string"}
      }
    },
    "nonEvaluableModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "motivo"],
      "properties": {
        "module_id": {"type": "string", "minLength": 1},
        "motivo": {"type": "string", "minLength": 1}
      }
    },
    "modularDenominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentes_validos", "module_ids", "modulos_bloqueados_excluidos"],
      "properties": {
        "componentes_validos": {"type": "integer", "minimum": 0},
        "module_ids": {"$ref": "#/$defs/stringList"},
        "modulos_bloqueados_excluidos": {"$ref": "#/$defs/stringList"}
      }
    },
    "reliabilityDenominator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentes_modulares_validos",
        "module_ids",
        "componentes_globais_validos",
        "modulos_bloqueados_excluidos"
      ],
      "properties": {
        "componentes_modulares_validos": {"type": "integer", "minimum": 0},
        "module_ids": {"$ref": "#/$defs/stringList"},
        "componentes_globais_validos": {"$ref": "#/$defs/stringList"},
        "modulos_bloqueados_excluidos": {"$ref": "#/$defs/stringList"}
      }
    },
    "globalDenominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentes_globais_validos"],
      "properties": {
        "componentes_globais_validos": {"$ref": "#/$defs/stringList"}
      }
    },
    "overallDenominator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eixos_validos", "eixos_sem_evidencia", "pesos_renormalizados"],
      "properties": {
        "eixos_validos": {"$ref": "#/$defs/stringList"},
        "eixos_sem_evidencia": {"$ref": "#/$defs/stringList"},
        "pesos_renormalizados": {"const": true}
      }
    },
    "denominators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibracao",
        "eficacia_integridade",
        "confiabilidade",
        "economia",
        "fluidez",
        "nota_geral"
      ],
      "properties": {
        "calibracao": {"$ref": "#/$defs/modularDenominator"},
        "eficacia_integridade": {"$ref": "#/$defs/modularDenominator"},
        "confiabilidade": {"$ref": "#/$defs/reliabilityDenominator"},
        "economia": {"$ref": "#/$defs/globalDenominator"},
        "fluidez": {"$ref": "#/$defs/globalDenominator"},
        "nota_geral": {"$ref": "#/$defs/overallDenominator"}
      }
    }
  }
}
