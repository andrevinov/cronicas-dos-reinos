{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avaliacoes-qualidade-interacao-v1.schema.json",
  "title": "Avaliações de qualidade por interação",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_avaliacoes_qualidade",
    "natureza",
    "regra_pontuacao",
    "assessments"
  ],
  "properties": {
    "schema_avaliacoes_qualidade": {
      "const": 1
    },
    "natureza": {
      "type": "string",
      "minLength": 1
    },
    "regra_pontuacao": {
      "type": "string",
      "minLength": 1
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      }
    },
    "experience_review": {
      "type": "object"
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "locator",
        "observation",
        "visibility"
      ],
      "properties": {
        "source": {
          "enum": [
            "rollout",
            "interaction",
            "receipt",
            "player_feedback",
            "canonical",
            "other"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "publica",
            "reservada"
          ]
        },
        "source_sha256": {
          "type": "string",
          "minLength": 1
        },
        "literal": {
          "type": "string",
          "minLength": 1
        },
        "literal_sha256": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason"
      ],
      "properties": {
        "state": {
          "enum": [
            "pendente",
            "confirmada",
            "parcial",
            "nao_confirmada",
            "indeterminada"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_quality_assessment",
        "assessment_id",
        "interaction_ref",
        "module_id",
        "capability_id",
        "criterion_id",
        "evaluator",
        "eligibility",
        "activation",
        "quality",
        "evidence",
        "adjudication"
      ],
      "properties": {
        "schema_quality_assessment": {
          "const": 1
        },
        "assessment_id": {
          "type": "string",
          "minLength": 1
        },
        "interaction_ref": {
          "type": "string",
          "pattern": "^(S[0-9]{3,}-I[0-9]{4,}|OBS-[a-f0-9]{20})$"
        },
        "module_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "evaluator": {
          "type": "string",
          "minLength": 1
        },
        "eligibility": {
          "enum": [
            "sim",
            "nao",
            "indeterminada"
          ]
        },
        "activation": {
          "enum": [
            "presente",
            "ausente",
            "indeterminada"
          ]
        },
        "quality": {
          "enum": [
            "adequada",
            "inadequada",
            "indeterminada",
            "nao_aplicavel"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "adjudication": {
          "$ref": "#/$defs/adjudication"
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "reviewer_role",
        "rubric_version",
        "configuration",
        "frame_sha256",
        "dependency_operation_ids",
        "uncertainty",
        "conflicts",
        "diagnosis",
        "independence",
        "guardrails"
      ],
      "properties": {
        "schema": {
          "const": 1
        },
        "reviewer_role": {
          "enum": [
            "revisor_poshoc",
            "produtor"
          ]
        },
        "rubric_version": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "type": "object",
          "minProperties": 1
        },
        "frame_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "dependency_operation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uncertainty": {
          "type": "string"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnosis": {
          "type": [
            "object",
            "null"
          ]
        },
        "independence": {
          "type": "string"
        },
        "verification": {
          "enum": [
            "verificada",
            "bloqueada"
          ]
        },
        "guardrails": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "ok",
              "violado",
              "indeterminada",
              "nao_aplicavel"
            ]
          }
        },
        "decision_state": {
          "enum": ["avaliada", "nao_aplicavel", "fontes_insuficientes"]
        },
        "public_diagnosis": {
          "type": "object",
          "additionalProperties": false,
          "required": ["finding", "correction", "test"],
          "properties": {
            "finding": {"type": "string"},
            "correction": {"type": "string"},
            "test": {"type": "string"}
          }
        }
      }
    }
  }
}
