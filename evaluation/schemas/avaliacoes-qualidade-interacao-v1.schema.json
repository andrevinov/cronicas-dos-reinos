{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avaliacoes-qualidade-interacao-v1.schema.json",
  "title": "Avaliações de qualidade por interação",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_avaliacoes_qualidade",
    "natureza",
    "regra_pontuacao",
    "assessments"
  ],
  "properties": {
    "schema_avaliacoes_qualidade": {"const": 1},
    "natureza": {"type": "string", "minLength": 1},
    "regra_pontuacao": {"type": "string", "minLength": 1},
    "assessments": {
      "type": "array",
      "items": {"$ref": "#/$defs/assessment"}
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "locator", "observation", "visibility"],
      "properties": {
        "source": {
          "enum": [
            "rollout",
            "interaction",
            "receipt",
            "player_feedback",
            "canonical",
            "other"
          ]
        },
        "locator": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["publica", "reservada"]}
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason"],
      "properties": {
        "state": {
          "enum": [
            "pendente",
            "confirmada",
            "parcial",
            "nao_confirmada",
            "indeterminada"
          ]
        },
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_quality_assessment",
        "assessment_id",
        "interaction_ref",
        "module_id",
        "capability_id",
        "criterion_id",
        "evaluator",
        "eligibility",
        "activation",
        "quality",
        "evidence",
        "adjudication"
      ],
      "properties": {
        "schema_quality_assessment": {"const": 1},
        "assessment_id": {"type": "string", "minLength": 1},
        "interaction_ref": {
          "type": "string",
          "pattern": "^S[0-9]{3,}-I[0-9]{4,}$"
        },
        "module_id": {"type": "string", "minLength": 1},
        "capability_id": {"type": ["string", "null"]},
        "criterion_id": {"type": "string", "minLength": 1},
        "evaluator": {"type": "string", "minLength": 1},
        "eligibility": {"enum": ["sim", "nao", "indeterminada"]},
        "activation": {"enum": ["presente", "ausente", "indeterminada"]},
        "quality": {
          "enum": ["adequada", "inadequada", "indeterminada", "nao_aplicavel"]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "adjudication": {"$ref": "#/$defs/adjudication"}
      }
    }
  }
}
