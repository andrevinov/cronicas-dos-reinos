{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corpus-regressao-rollout.schema.json",
  "title": "Corpus independente de regressão do avaliador de rollouts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_corpus_regressao_rollout",
    "versao_corpus",
    "natureza",
    "fonte_expectativas",
    "escopo",
    "configuracao",
    "sha256_configuracao",
    "casos",
    "relacoes"
  ],
  "properties": {
    "schema_corpus_regressao_rollout": {
      "const": 1
    },
    "versao_corpus": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "natureza": {
      "type": "string",
      "minLength": 1
    },
    "fonte_expectativas": {
      "type": "string",
      "minLength": 1
    },
    "escopo": {
      "type": "string",
      "minLength": 1
    },
    "configuracao": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogo",
        "metas",
        "baseline",
        "guardrails",
        "series",
        "releases",
        "contrato_medicao",
        "contratos_modulos",
        "interacoes",
        "validade"
      ],
      "properties": {
        "catalogo": {
          "type": "string",
          "minLength": 1
        },
        "metas": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "guardrails": {
          "type": "string",
          "minLength": 1
        },
        "series": {
          "type": "string",
          "minLength": 1
        },
        "releases": {
          "type": "string",
          "minLength": 1
        },
        "contrato_medicao": {
          "type": "string",
          "minLength": 1
        },
        "contratos_modulos": {
          "type": "string",
          "minLength": 1
        },
        "interacoes": {
          "type": "string",
          "minLength": 1
        },
        "validade": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sha256_configuracao": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "casos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "descricao",
          "conjunto",
          "origem",
          "rollout",
          "sha256_rollout",
          "gabarito",
          "sha256_gabarito",
          "adjudicacoes",
          "tags",
          "sha256_adjudicacoes"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "conjunto": {
            "const": "desenvolvimento"
          },
          "origem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo",
              "referencias_s023"
            ],
            "properties": {
              "tipo": {
                "enum": [
                  "sintetico",
                  "reducao_s023"
                ]
              },
              "referencias_s023": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "rollout": {
            "type": "string",
            "minLength": 1
          },
          "sha256_rollout": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "gabarito": {
            "type": "string",
            "minLength": 1
          },
          "sha256_gabarito": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "adjudicacoes": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sha256_adjudicacoes": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "relacoes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation_id",
          "tipo",
          "casos",
          "caminhos",
          "unidade_excluida",
          "justificativa"
        ],
        "properties": {
          "relation_id": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "const": "equivalencia"
          },
          "casos": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "caminhos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          },
          "unidade_excluida": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "string",
                "integer"
              ]
            }
          },
          "justificativa": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Hashes, paths, referências entre casos, evidências e unidades são validados semanticamente por verificar_corpus_avaliacao.py."
}
